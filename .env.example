# Public client endpoints only. Never add signing keys or deploy tokens here.
# Copy this file to .env.local and use your Convex deployment's URLs.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Token-free Apple/Leaflet renderer, including Android standalone APKs.
EXPO_PUBLIC_MAP_RENDERER=leaflet
